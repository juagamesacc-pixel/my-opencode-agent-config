# Dependencies — regenerable via `npm install` from package.json/package-lock.json
node_modules/

# OS / editor junk
.DS_Store
Thumbs.db
*.log

# Temp / backup noise (keep explicit .bak files like opencode.jsonc.bak if present)
*.tmp
*.swp
# Runtime data — regenerated on device (note MCP/CLI writes this live)
note/note.db
note/note.db-*

# Runtime/workspace state (skills + sqlite journals) — never commit
.slim/
*.db-wal
*.db-shm

# Screenshot tool working dir (screenshot_read copies device PNGs here)
**/ss/
