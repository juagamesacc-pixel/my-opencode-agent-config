{
  "$schema": "https://opencode.ai/config.json",
  "plugin": [
    "oh-my-opencode-slim"
  ],
  "agent": {
    "explore": {
      "disable": true
    },
    "general": {
      "disable": true
    }
  },
  "subagent_depth": 2,
  "lsp": true,
  "mcp": {
    "rulebook": {
      "type": "local",
      "command": [
        "/root/.bun/bin/bun",
        "/root/.config/opencode/rulebook/rulebook.ts",
        "--mcp"
      ],
      "environment": {}
    },
    "note": {
      "type": "local",
      "command": [
        "/root/.bun/bin/bun",
        "/root/.config/opencode/note/note.ts",
        "--mcp"
      ],
      "environment": {}
    }
  }
}
